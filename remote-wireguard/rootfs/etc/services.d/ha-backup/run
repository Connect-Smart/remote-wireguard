#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant Third Party Add-on: WireGuard Client
# HA Backup service - dagelijks op ingesteld tijdstip, met retry logica
# ==============================================================================

DEFAULT_BACKUP_TIME="02:00"
MAX_RETRIES=3
RETRY_INTERVAL=1800  # 30 minuten tussen retries

# Controleer of backup ingeschakeld is
BACKUP_ENABLED="true"
if bashio::config.has_value "backup_enabled"; then
    BACKUP_ENABLED=$(bashio::config "backup_enabled")
elif bashio::config.has_value "advanced.backup_enabled"; then
    BACKUP_ENABLED=$(bashio::config "advanced.backup_enabled")
fi

if [[ "${BACKUP_ENABLED,,}" != "true" ]]; then
    bashio::log.info "HA Backup: uitgeschakeld via configuratie"
    exit 0
fi

# Tijdstip ophalen (formaat HH:MM)
BACKUP_TIME="${DEFAULT_BACKUP_TIME}"
if bashio::config.has_value "backup_time"; then
    BACKUP_TIME=$(bashio::config "backup_time")
fi
if ! [[ "${BACKUP_TIME}" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
    bashio::log.warning "HA Backup: ongeldige backup_time '${BACKUP_TIME}', standaard ${DEFAULT_BACKUP_TIME} wordt gebruikt"
    BACKUP_TIME="${DEFAULT_BACKUP_TIME}"
fi

SCRIPT="/etc/services.d/ha-backup/create_backup.sh"

# Bereken seconden tot het volgende geplande tijdstip.
# Gebruikt bewust alleen "date +FORMAT" en bash-arithmetiek (geen "date -d/-j/-v"
# parsing), want dat verschilt te veel tussen GNU/BusyBox/BSD date en liet de
# service eerder telkens meteen crashen (en dus herstarten) op dit BusyBox-image.
seconds_until_next_run() {
    local target_hour target_min cur_hour cur_min cur_sec target_secs cur_secs diff

    target_hour=$(echo "${BACKUP_TIME}" | cut -d: -f1)
    target_min=$(echo "${BACKUP_TIME}" | cut -d: -f2)
    # 10# voorkomt dat bijv. "08"/"09" als (ongeldig) octaal wordt gelezen
    target_hour=$((10#${target_hour}))
    target_min=$((10#${target_min}))

    cur_hour=$((10#$(date +%H)))
    cur_min=$((10#$(date +%M)))
    cur_sec=$((10#$(date +%S)))

    target_secs=$(( target_hour * 3600 + target_min * 60 ))
    cur_secs=$(( cur_hour * 3600 + cur_min * 60 + cur_sec ))

    diff=$(( target_secs - cur_secs ))
    if (( diff <= 0 )); then
        diff=$(( diff + 86400 ))
        echo "${diff} true"
    else
        echo "${diff} false"
    fi
}

bashio::log.info "HA Backup service gestart (dagelijks om ${BACKUP_TIME}, max ${MAX_RETRIES} retries)"

while true; do
    read -r WAIT TOMORROW <<< "$(seconds_until_next_run)"
    if ! [[ "${WAIT}" =~ ^[0-9]+$ ]]; then
        WAIT=3600
        TOMORROW=false
    fi
    if [[ "${TOMORROW}" == "true" ]]; then
        bashio::log.info "HA Backup: volgende backup gepland morgen om ${BACKUP_TIME}"
    else
        bashio::log.info "HA Backup: volgende backup gepland vandaag om ${BACKUP_TIME}"
    fi
    sleep "${WAIT}"

    SUCCESS=false
    for attempt in $(seq 1 ${MAX_RETRIES}); do
        bashio::log.info "HA Backup: poging ${attempt}/${MAX_RETRIES}..."
        if ${SCRIPT}; then
            SUCCESS=true
            break
        fi
        if [[ "${attempt}" -lt "${MAX_RETRIES}" ]]; then
            bashio::log.warning "HA Backup: poging ${attempt} mislukt, volgende poging over $(( RETRY_INTERVAL / 60 )) minuten"
            sleep "${RETRY_INTERVAL}"
        fi
    done

    if [[ "${SUCCESS}" != "true" ]]; then
        bashio::log.warning "HA Backup: alle ${MAX_RETRIES} pogingen mislukt, volgende kans morgen om ${BACKUP_TIME}"
    fi
done
